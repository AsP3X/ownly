# Human: Reverse proxy for Vite static assets and API uploads.
# Agent: envsubst replaces ${MAX_UPLOAD_BYTES}, ${NGINX_PROXY_READ_TIMEOUT}, and ${NGINX_PROXY_CONNECT_TIMEOUT} at container start.

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Human: Keep container logs readable — collab traffic is filtered via $log_collab_request map.
    # Agent: error_log warn (not debug); access_log skips document/spreadsheet ops+heartbeat paths.
    error_log /dev/stderr warn;
    access_log /dev/stdout combined if=$log_collab_request;

    # Human: Baseline security headers for the static SPA shell (SEC-025).
    # Agent: APPLIES to all responses; CSP allows same-origin API + inline Vite bootstrap.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    # Human: HSTS for deployments served behind TLS — ignored on plain HTTP local dev.
    # Agent: SET max-age 1y; PAIRED with reverse proxy terminating HTTPS in production.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Human: Compress text assets — hashed /assets/* benefit on every repeat visit.
    # Agent: gzip on; TYPES include js/css/json/svg/woff2; VARY for downstream caches.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        image/svg+xml
        font/woff2;

    # Human: Alpine nginx omits .mjs — pdf.js worker fails strict module MIME checks without this.
    # Agent: MERGES application/javascript for mjs; REQUIRED for react-pdf worker in /assets/*.mjs.
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    # Agent: Must match backend MAX_UPLOAD_BYTES — nginx rejects the body before Axum sees it.
    client_max_body_size ${MAX_UPLOAD_BYTES};

    # Human: Fingerprinted Vite output — safe to cache for one year (filename changes on rebuild).
    # Agent: location /assets/ BEFORE location /; Cache-Control immutable.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Human: SPA shell must revalidate so deploys pick up new chunk hashes in index.html.
    location = /index.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /api/v1/ {
        proxy_pass http://backend:3000/api/v1/;
        proxy_http_version 1.1;
        # Human: WebSocket upgrade for document/spreadsheet collab live channels.
        # Agent: USES $connection_upgrade map from nginx-http-map.conf; REQUIRED for /sessions/*/ws.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Human: Preserve browser fetch metadata and Origin for user-creation guards on the API.
        # Agent: FORWARDS Sec-Fetch-* and Origin; REQUIRED when an outer TLS proxy already stripped them.
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
        proxy_set_header Sec-Fetch-Mode $http_sec_fetch_mode;
        proxy_set_header Sec-Fetch-Dest $http_sec_fetch_dest;
        proxy_set_header Origin $http_origin;
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        # Human: Long-lived WS collab sockets need a high read timeout (default often 60s).
        proxy_read_timeout 3600s;
        proxy_send_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_request_buffering off;
        # Human: Stream multi-MiB HLS segments to the browser without nginx disk buffering delays.
        # Agent: proxy_buffering off; HELPS hls.js finish XHR before fragLoadingTimeOut on seek.
        proxy_buffering off;
    }

    # Human: Expose Nebular presigned GET + browser-direct part PUT on the same origin.
    # Agent: PROXIES /media/* to object-storage; ENABLES presigned GET/PUT without publishing port 9000.
    # Agent: request_buffering off so multi-MiB staging PUTs stream; client_max_body_size inherits server max.
    location /media/ {
        proxy_pass http://object-storage:9000/media/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Human: Belt-and-suspenders for any remaining .mjs assets from future bundler output.
    # Agent: FORCES application/javascript Content-Type; MATCHES location before generic static fallthrough.
    location ~* \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }
}
