      "name": "File Context Menu — Order",
      "width": 220,
      "height": 320,
      "fill": "#FFFFFF",
      "cornerRadius": 8,
      "stroke": "#E5E7EB",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 2,
      "padding": 6,
      "effect": {
        "type": "shadow",
        "shadowType": "outer",
        "color": "#00000014",
        "offset": { "x": 0, "y": 8 },
        "blur": 16
      },
      "children": [
        {
          "type": "frame",
          "id": "cmOpenRow",
          "name": "Open split row",
          "width": "fill_container",
