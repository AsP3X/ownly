{
  "version": "2.13",
  "children": [
    {
      "type": "frame",
      "id": "fdRoot",
      "x": 0,
      "y": 0,
      "name": "File Details Overlay — Desktop",
      "clip": true,
      "width": 1440,
      "height": 1024,
      "fill": "#0A0A1080",
      "layout": "none",
      "children": [
        {
          "type": "frame",
          "id": "fdCard",
          "x": 420,
          "y": 140,
          "name": "Details Card",
          "width": 600,
          "height": 720,
          "fill": "#FFFFFF",
          "cornerRadius": 16,
          "stroke": "#E5E7EB",
          "strokeWidth": 1,
          "layout": "vertical",
          "effect": {
            "type": "shadow",
            "shadowType": "outer",
            "color": "#00000029",
            "offset": { "x": 0, "y": 16 },
            "blur": 48
          },
          "children": [
            {
              "type": "frame",
              "id": "fdHeader",
              "name": "Header",
              "width": "fill_container",
              "layout": "horizontal",
              "gap": 16,
              "padding": [24, 28],
              "alignItems": "center",
              "stroke": "#F3F4F6",
              "strokeWidth": { "bottom": 1 },
              "children": [
                {
                  "type": "frame",
                  "id": "fdIconWrap",
                  "name": "Type icon",
                  "width": 48,
                  "height": 48,
                  "cornerRadius": 12,
                  "fill": "#EFF6FF",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "fdIcon",
                      "width": 24,
                      "height": 24,
                      "icon": "file-video",
                      "library": "lucide",
                      "fill": "#2563EB"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fdTitleCol",
                  "name": "Title column",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "fdTitle",
                      "fill": "#111827",
                      "content": "vacation-highlight.mp4",
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "fdSubtitle",
                      "fill": "#6B7280",
                      "content": "Video · 248 MB · Ready to stream",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "400"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fdClose",
                  "name": "Close",
                  "width": 32,
                  "height": 32,
                  "cornerRadius": 8,
                  "fill": "#F3F4F6",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "fdCloseIcon",
                      "width": 16,
                      "height": 16,
                      "icon": "x",
                      "library": "lucide",
                      "fill": "#6B7280"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "fdTabs",
              "name": "Tabs",
              "width": "fill_container",
